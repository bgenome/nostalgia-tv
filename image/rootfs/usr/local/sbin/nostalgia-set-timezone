#!/bin/bash
set -eu

zone="${1:-}"
case "${zone}" in
	America/New_York|America/Chicago|America/Denver|America/Los_Angeles|Europe/London|Europe/Berlin|UTC)
		;;
	*)
		echo "Unknown clock" >&2
		exit 1
		;;
esac

if [ ! -f "/usr/share/zoneinfo/${zone}" ]; then
	echo "Unknown clock" >&2
	exit 1
fi

ln -sfn "/usr/share/zoneinfo/${zone}" /etc/localtime
printf '%s\n' "${zone}" > /etc/timezone
